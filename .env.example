# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Only placeholders belong in this file.

# --- Gemini (provider: gemini) -------------------------------------------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- Ollama (provider: ollama) -------------------------------------------
# No credential is required for a local Ollama server.
LOCAL_AGENT_OLLAMA_BASE_URL=http://localhost:11434

# --- Connector credentials -------------------------------------------------
# A connector names the variables it needs; the values live here and are never
# written to connectors.json. Add whatever your MCP servers require, e.g.:
# GITHUB_TOKEN=your-token-here
# LINEAR_API_KEY=your-key-here

# --- Runtime overrides ----------------------------------------------------
# Every config.yaml key can be overridden with the LOCAL_AGENT_ prefix.
# LOCAL_AGENT_PROVIDER=ollama
# LOCAL_AGENT_MODEL=llama3.1
# LOCAL_AGENT_APPROVAL_MODE=risky
# LOCAL_AGENT_WORKSPACE=./workspace
# LOCAL_AGENT_LOG_LEVEL=INFO
